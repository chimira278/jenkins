#!/usr/bin/env groovy

pipelineJob('clinica-api-e2e-test') {
    displayName('clinica-api-e2e-test')

    description('Clinica API End-to-end Testing')

    logRotator {
        daysToKeep(1)
    }

    configure { project ->
        project / 'properties' / 'org.jenkinsci.plugins.workflow.job.properties.DurabilityHintJobProperty' {
            hint('PERFORMANCE_OPTIMIZED')
        }
    }

    properties {
        disableConcurrentBuilds {
            abortPrevious(false)
        }
    }

    definition {
        cpsScm {
            scm {
                git {
                    remote {
                        url('https://github.com/jayamorin/jenkins.git')
                        credentials('GITHUB_TOKEN')
                    }
                    branches('*/main')
                }
            }

            scriptPath('pipelines/api-e2e.jenkins')
        }
    }
}